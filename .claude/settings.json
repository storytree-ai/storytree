{
  "attribution": {
    "sessionUrl": false
  },
  "enabledMcpjsonServers": [
    "storytree"
  ],
  "permissions": {
    "allow": [
      "mcp__storytree",
      "Bash(pnpm storytree:*)",
      "Bash(pnpm -s storytree:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node packages/base-dev-loop/src/provision-worktree.mjs --hook",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx packages/app-setup/src/bins/storytree-hook.ts claude-code --test-guard by-agent",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
