{
  "enabledMcpjsonServers": [
    "storytree"
  ],
  "permissions": {
    "allow": [
      "mcp__storytree",
      "Bash(pnpm storytree:*)",
      "Bash(pnpm -s storytree:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node packages/base-dev-loop/src/provision-worktree.mjs --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
