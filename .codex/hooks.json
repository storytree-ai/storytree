{
  "description": "0.3's own development: install a fresh or stale worktree's dependencies at session start, and let only the test-writer agent edit test code, judging its shell commands' file writes by the same path rule (ADR-1355 D2).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node packages/base-dev-loop/src/provision-worktree.mjs --hook",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node --import tsx packages/app-setup/src/bins/storytree-hook.ts codex --test-guard by-agent",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
