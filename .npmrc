# pnpm runs this repository's scripts through its own shell, not cmd.exe or sh (ADR-0851 D1): pnpm
# appends the words given to `pnpm <script>` as JSON strings, which cmd.exe cuts at a > or & once a
# word holds a double quote, and in which sh runs what is between backticks (the command line's contract 16.1).
shell-emulator=true
