{
  "name": "@storytree/desktop",
  "private": true,
  "version": "0.3.0",
  "description": "storytree 0.3 desktop app: a project's stories and their health, read from the local library",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "smoke": "node build.mjs && electron . --smoke --screenshot smoke.png",
    "typecheck": "tsc -p .",
    "dist": "node build.mjs && node dist.mjs"
  },
  "devDependencies": {
    "@storytree/agent-link": "workspace:*",
    "@storytree/app": "workspace:*",
    "@storytree/app-setup": "workspace:*",
    "@storytree/arc-surface": "workspace:^",
    "@storytree/forest": "workspace:^",
    "@storytree/knowledge-core": "workspace:*",
    "@storytree/library": "workspace:*",
    "@storytree/local-postgres": "workspace:*",
    "@types/node": "^24.13.6",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  },
  "build": {
    "appId": "ai.storytree.desktop-0-3",
    "productName": "storytree-0.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/LICENSE",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "node_modules/@embedded-postgres/windows-x64/native",
        "to": "postgres"
      }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "storytree-ai",
      "repo": "storytree",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "storytree-0.3-${version}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "storytree-0.3-${version}-portable-${arch}.${ext}"
    }
  }
}
