{
  "name": "@storytree/desktop",
  "private": true,
  "version": "0.3.0",
  "description": "storytree 0.3 desktop app: a project's stories and their health, read from the local library",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "smoke": "node build.mjs && electron . --smoke --screenshot smoke.png",
    "typecheck": "tsc -p .",
    "dist": "node build.mjs && node --import tsx dist.mjs"
  },
  "devDependencies": {
    "@google-cloud/cloud-sql-connector": "^1.11.1",
    "@huggingface/transformers": "^4.3.0",
    "@storytree/agent-link": "workspace:*",
    "@storytree/app": "workspace:*",
    "@storytree/app-setup": "workspace:*",
    "@storytree/arc-surface": "workspace:^",
    "@storytree/forest": "workspace:^",
    "@storytree/identity": "workspace:*",
    "@storytree/journey-events": "workspace:*",
    "@storytree/knowledge-core": "workspace:*",
    "@storytree/library": "workspace:*",
    "@storytree/local-postgres": "workspace:*",
    "@storytree/map": "workspace:*",
    "@types/node": "^24.13.6",
    "@workos-inc/node": "^10.4.0",
    "@workos/authkit-electron": "0.1.2",
    "@workos/authkit-session": "0.6.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "google-auth-library": "^10.6.2",
    "playwright-core": "1.60.0",
    "typescript": "~7.0.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  },
  "build": {
    "appId": "ai.storytree.desktop-0-3",
    "productName": "storytree-0.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/LICENSE",
      "!dist/**/*.map",
      "!dist/agent-tools/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "dist/agent-tools/${arch}",
        "to": "agent-tools"
      },
      {
        "from": "dist/agent-tools/${arch}/node_modules",
        "to": "agent-tools/node_modules"
      }
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "storytree sign-in",
        "schemes": [
          "storytree-auth"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "storytree-ai",
      "repo": "storytree",
      "releaseType": "release"
    },
    "win": {
      "extraResources": [
        {
          "from": "node_modules/@embedded-postgres/windows-x64/native",
          "to": "postgres"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "signIgnore": [
        "/Contents/Resources/agent-tools/"
      ],
      "extraResources": [
        {
          "from": "node_modules/@embedded-postgres/darwin-arm64/native",
          "to": "postgres"
        }
      ],
      "artifactName": "storytree-0.3-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "storytree-0.3-${version}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "storytree-0.3-${version}-portable-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "storytree-0.3-${version}-${arch}.${ext}"
    }
  }
}
