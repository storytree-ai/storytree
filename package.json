{
  "name": "storytree",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "storytree": "node packages/dev-loop/src/provision-worktree.mjs --check && node --import tsx packages/cli/src/bins/storytree.ts",
    "test": "node --import tsx packages/dev-loop/src/test.mjs",
    "gate": "node packages/dev-loop/src/gate.mjs",
    "typecheck": "pnpm -r typecheck",
    "test-ratio": "node packages/dev-loop/src/test-ratio.mjs",
    "survey:coverage": "node --import tsx packages/dev-loop/src/survey-coverage.mjs",
    "check:own-health": "node --import tsx packages/dev-loop/src/check-own-health.mjs",
    "record:acceptance": "node --import tsx packages/dev-loop/src/record-acceptance.mjs",
    "library:export": "node --import tsx packages/dev-loop/src/export-library.mjs",
    "desktop": "pnpm --filter @storytree/desktop start",
    "desktop:smoke": "pnpm --filter @storytree/desktop smoke",
    "desktop:dist": "pnpm --filter @storytree/desktop dist",
    "app:follow-main": "node --import tsx packages/app/src/updates/follow-main-setup.ts",
    "build:guidance": "node --import tsx packages/dev-loop/src/build-guidance.mjs",
    "check:guidance": "node --import tsx packages/dev-loop/src/build-guidance.mjs --check"
  },
  "devDependencies": {
    "@storytree/agent-link": "workspace:*",
    "@storytree/dev-loop": "workspace:*",
    "@storytree/library": "workspace:*",
    "@storytree/local-postgres": "workspace:*",
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "win32"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    }
  }
}
