{
  "name": "storytree",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "storytree": "node --import tsx packages/cli/src/bins/storytree.ts",
    "test": "node --import tsx scripts/test.mjs",
    "gate": "node scripts/gate.mjs",
    "typecheck": "pnpm -r typecheck",
    "test-ratio": "node scripts/test-ratio.mjs",
    "check:own-health": "node --import tsx scripts/check-own-health.mjs",
    "library:export": "node --import tsx scripts/export-library.mjs",
    "desktop": "pnpm --filter @storytree/desktop start",
    "desktop:smoke": "pnpm --filter @storytree/desktop smoke",
    "desktop:dist": "pnpm --filter @storytree/desktop dist",
    "app:follow-main": "node --import tsx scripts/follow-main.mjs",
    "build:guidance": "node --import tsx scripts/build-guidance.mjs",
    "check:guidance": "node --import tsx scripts/build-guidance.mjs --check"
  },
  "devDependencies": {
    "@storytree/agent-link": "workspace:*",
    "@storytree/library": "workspace:*",
    "@storytree/local-postgres": "workspace:*",
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    }
  }
}
