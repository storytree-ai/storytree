{
  "name": "@storytree/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lifecycle/bridge": "./src/lifecycle/bridge.ts",
    "./lifecycle/verbs": "./src/lifecycle/verbs.ts",
    "./projects": "./src/projects/follow.ts",
    "./projects/bridge": "./src/projects/bridge.ts",
    "./surfaces": "./src/surfaces/bridge.ts",
    "./surfaces/verbs": "./src/surfaces/verbs.ts",
    "./updates/bridge": "./src/updates/bridge.ts",
    "./updates/verbs": "./src/updates/verbs.ts",
    "./version": "./src/updates/version.ts",
    "./view": "./src/view/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@storytree/mark": "workspace:*",
    "@storytree/session-management": "workspace:*",
    "@storytree/library": "workspace:*",
    "electron-updater": "6.8.9",
    "pg": "^8.23.0",
    "@storytree/project-and-caller": "workspace:*"
  },
  "devDependencies": {
    "@storytree/local-postgres": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "builder-util": "26.15.3",
    "happy-dom": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "@storytree/app-setup": "workspace:*"
  },
  "storytree": {
    "verbs": [
      {
        "from": "./lifecycle/verbs",
        "export": "APP_FAMILIES"
      },
      {
        "from": "./surfaces/verbs",
        "export": "SETTINGS_FAMILIES"
      },
      {
        "from": "./updates/verbs",
        "export": "RELEASE_FAMILIES"
      }
    ]
  }
}
