# The Mint box's factory health (factory-health.sh, contract 12.9): after the factory moves, its plugins' own test runs
# are recorded as their stories' verified health, from a checkout of storytree's main kept for this alone.
# Install as the owner:
#   mkdir -p ~/storytree-lanes/factory-health && cp packages/dev-loop/box/factory-health.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now factory-health.timer
[Unit]
Description=storytree: record the factory plugins' health at a new factory commit

[Service]
Type=oneshot
Environment=RUNNER=%h/storytree-lanes/factory-health/runner
ExecStartPre=/bin/sh -c 'test -d "$RUNNER/.git" || git clone -q https://github.com/storytree-ai/storytree.git "$RUNNER"'
ExecStartPre=/bin/sh -c 'git -C "$RUNNER" fetch -q origin main && git -C "$RUNNER" checkout -q --detach FETCH_HEAD'
ExecStart=/bin/bash -c 'exec bash "$RUNNER/packages/dev-loop/box/factory-health.sh"'
TimeoutStartSec=3h
StandardOutput=append:%h/storytree-lanes/factory-health/timer.log
StandardError=append:%h/storytree-lanes/factory-health/timer.log
