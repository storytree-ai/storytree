{
  "name": "@storytree/lag-in-use",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.ts",
    "./runtime": "./src/runtime.ts",
    "./view": "./src/view.ts",
    "./verbs": "./src/verbs.ts"
  },
  "storytree": {
    "pageChannels": [
      {
        "from": "./bridge",
        "export": "lagPageChannels"
      }
    ],
    "pageAnswers": [
      {
        "from": "./runtime",
        "export": "lagPageAnswers"
      }
    ],
    "verbs": [
      {
        "from": "./verbs",
        "export": "LAG_FAMILIES"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@storytree/forest": "workspace:*",
    "@storytree/project-and-caller": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "happy-dom": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
